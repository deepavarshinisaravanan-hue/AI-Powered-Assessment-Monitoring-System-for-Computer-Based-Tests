# Database Configuration Template
# Copy this file to .env and set your system's local database credentials.
# Do NOT commit your local .env file to Git!

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=cbt_monitoring_db

